<Window x:Class="Konditer.Auth"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Konditer"
        mc:Ignorable="d"
        Title="Auth" Height="328" Width="490" WindowStartupLocation="CenterScreen">
    <Grid>
        <Label Content="Авторизация" HorizontalAlignment="Left" Margin="169,25,0,0" VerticalAlignment="Top" FontSize="20"/>
        <PasswordBox x:Name="passBox" HorizontalAlignment="Left" Margin="224,140,0,0" VerticalAlignment="Top" Width="155" FontSize="16"/>
        <TextBox x:Name="usernameBox" HorizontalAlignment="Left" Margin="225,92,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="155" FontSize="16"/>
        <Label Content="Логин" HorizontalAlignment="Left" Margin="114,88,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Margin="113,134,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Button Content="Войти" HorizontalAlignment="Center" Margin="0,190,0,0" VerticalAlignment="Top" Width="266" Click="Button_Click" FontSize="16"/>
        <Label Content="Нет аккаунта?" HorizontalAlignment="Left" Margin="113,220,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label HorizontalAlignment="Left" Margin="225,220,0,0" VerticalAlignment="Top" FontSize="16" MouseDown="Label_MouseDown">
            <TextBlock TextDecorations="Underline" Text="Зарегистрироваться!"/>
        </Label>
    </Grid>
</Window>
