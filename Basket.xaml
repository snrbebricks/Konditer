<Window x:Class="Konditer.Basket"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Konditer"
        mc:Ignorable="d"
        Title="Basket" Height="415" Width="779" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">
    <Grid>
        <Label Content="Корзина" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
        <Button Content="Вернуться в меню" HorizontalAlignment="Left" Margin="465,18,0,0" VerticalAlignment="Top" Click="Button_Click" Height="29" Width="141"/>
        <GroupBox Header="Выбранные товары" Margin="10,32,436,10" FontSize="14">
            <ListView x:Name="listView">
            </ListView>
        </GroupBox>
        <Button Content="Оформить заказ" HorizontalAlignment="Left" Margin="348,177,0,0" VerticalAlignment="Top" Height="34" Width="391" Click="Button_Click_1" FontSize="16"/>
        <Label Content="Выберите способ оплаты:" HorizontalAlignment="Left" Margin="348,78,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Итого к оплате:" HorizontalAlignment="Left" Margin="348,141,0,0" VerticalAlignment="Top" FontSize="16"/>
        <ComboBox HorizontalAlignment="Left" Margin="552,78,0,0" VerticalAlignment="Top" Width="187" Height="31" FontSize="16">
            <ComboBoxItem Content="Банковская карта"/>
            <ComboBoxItem Content="Наличными"/>
            <ComboBoxItem Content="СБП"/>
        </ComboBox>
        <Label x:Name="lastPriceL" Content="" HorizontalAlignment="Left" Margin="477,141,0,0" VerticalAlignment="Top" FontSize="16" FontWeight="Bold" Width="109"/>

    </Grid>
</Window>
