<Window x:Class="Konditer.OrderContent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Konditer"
        mc:Ignorable="d"
        Title="OrderContent" Height="528" Width="401" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Label Content="Содержимое заказа" HorizontalAlignment="Center" Margin="0,19,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
        <ListView x:Name="listView" Margin="10,61,10,0" Height="316" VerticalAlignment="Top">
        </ListView>
        <Button Content="Вернуться назад" HorizontalAlignment="Center" Margin="0,450,0,0" VerticalAlignment="Top" Width="381" Click="Button_Click" Height="28"/>
        <Label Content="Итого:" HorizontalAlignment="Left" Margin="10,382,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
        <Label x:Name="priceL" Content="99999 Р." HorizontalAlignment="Left" Margin="301,377,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold" Width="90" RenderTransformOrigin="0.5,0.5"/>
        <Button Content="Удалить заказ" HorizontalAlignment="Center" Margin="0,417,0,0" VerticalAlignment="Top" Width="381" Click="Button_Click_1" Height="28"/>

    </Grid>
</Window>
