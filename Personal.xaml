<Window x:Class="Konditer.Personal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Konditer"
        mc:Ignorable="d"
        Title="Personal" Height="595" Width="1514" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">
    <Grid HorizontalAlignment="Center" Width="1514">
        <Label Content="Сотрудники" HorizontalAlignment="Left" Margin="600,10,0,0" VerticalAlignment="Top" FontSize="24" FontWeight="Bold"/>
        <GroupBox Header="Перечень сотрудников" Margin="10,78,1066,10" FontSize="18">
            <ListView x:Name="listView">
            </ListView>
        </GroupBox>
        <GroupBox Header="Информация" Margin="453,78,504,10" FontSize="18">
            <Grid>
                <Label Content="Фамилия:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>
                <Label Content="Имя:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,49,0,0"/>
                <Label Content="Отчество:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,88,0,0"/>
                <Label Content="Почта:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,127,0,0"/>
                <Label Content="Номер:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,166,0,0"/>
                <Label Content="Логин:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,205,0,0"/>
                <Label Content="Пароль:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,244,0,0"/>
                <Label Content="Роль:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,283,0,0"/>
                <TextBox x:Name="firstLabel" HorizontalAlignment="Left" Margin="134,18,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364"/>
                <TextBox x:Name="nameLabel" HorizontalAlignment="Left" Margin="134,57,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364"/>
                <TextBox x:Name="lastLabel" HorizontalAlignment="Left" Margin="134,96,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364"/>
                <TextBox x:Name="mailLabel" HorizontalAlignment="Left" Margin="134,135,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364"/>
                <TextBox x:Name="numberLabel" HorizontalAlignment="Left" Margin="134,174,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364"/>
                <TextBox x:Name="usernameLabel" HorizontalAlignment="Left" Margin="134,213,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364"/>
                <TextBox x:Name="passwordLabel" HorizontalAlignment="Left" Margin="134,252,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364"/>
                <ComboBox x:Name="roleLabel" Margin="134,287,47,0" VerticalAlignment="Top">
                    <ComboBoxItem>Админисратор</ComboBoxItem>
                    <ComboBoxItem>Пользователь</ComboBoxItem>
                </ComboBox>
                <Button Content="Изменить" HorizontalAlignment="Left" Margin="10,339,0,0" VerticalAlignment="Top" Height="37" Width="488" Click="Button_Click_3"/>
                <Button Content="Сохранить" HorizontalAlignment="Left" Margin="10,383,0,0" VerticalAlignment="Top" Height="37" Width="488" Click="Button_Click_5"/>
            </Grid>
        </GroupBox>
        <GroupBox Header="Поиск сотрудника" Margin="1015,78,22,95" FontSize="18">
            <Grid>
                <Label Content="По номеру:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="numBox" HorizontalAlignment="Left" Margin="119,18,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="334"/>
                <Button Content="Найти" HorizontalAlignment="Left" Margin="10,49,0,0" VerticalAlignment="Top" Width="443" Click="Button_Click"/>
                <Label Content="По ID:" HorizontalAlignment="Left" Margin="10,101,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="idBox" HorizontalAlignment="Left" Margin="75,109,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="378"/>
                <Button Content="Найти" HorizontalAlignment="Left" Margin="10,140,0,0" VerticalAlignment="Top" Width="443" Click="Button_Click_1"/>
                <Label Content="По почте:" HorizontalAlignment="Left" Margin="10,191,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="mailBox" HorizontalAlignment="Left" Margin="105,199,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="348"/>
                <Button Content="Найти" HorizontalAlignment="Left" Margin="10,230,0,0" VerticalAlignment="Top" Width="443" Click="Button_Click_2"/>
                <Label Content="По логину:" HorizontalAlignment="Left" Margin="10,270,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="usernameBox" HorizontalAlignment="Left" Margin="114,278,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="339"/>
                <Button Content="Найти" HorizontalAlignment="Left" Margin="10,309,0,0" VerticalAlignment="Top" Width="443" Click="Button_Click_4"/>

            </Grid>
        </GroupBox>
        <Button Content="Вернуться в меню" HorizontalAlignment="Left" Margin="1015,489,0,0" VerticalAlignment="Top" Height="49" Width="477" FontSize="18" Click="Button_Click_6"/>
    </Grid>
</Window>
