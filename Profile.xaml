<Window x:Class="Konditer.Profile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Konditer"
        mc:Ignorable="d"
        Title="Profile" Height="597" Width="569" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Label Content="Профиль" HorizontalAlignment="Center" Margin="0,27,0,0" VerticalAlignment="Top" FontSize="22" FontWeight="Bold"/>
        <GroupBox Header="Личная информация" Margin="10,70,0,0" FontSize="18" Height="478" VerticalAlignment="Top" HorizontalAlignment="Left" Width="529">
            <Grid>
                <Label Content="Фамилия:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>
                <Label Content="Имя:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,49,0,0"/>
                <Label Content="Отчество:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,88,0,0"/>
                <Label Content="Почта:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,127,0,0"/>
                <Label Content="Номер:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,166,0,0"/>
                <Label Content="Логин:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,205,0,0"/>
                <Label Content="Пароль:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,244,0,0"/>
                <TextBox x:Name="firstLabel" HorizontalAlignment="Left" Margin="134,18,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364"/>
                <TextBox x:Name="nameLabel" HorizontalAlignment="Left" Margin="134,57,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364"/>
                <TextBox x:Name="lastLabel" HorizontalAlignment="Left" Margin="134,96,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364"/>
                <TextBox x:Name="mailLabel" HorizontalAlignment="Left" Margin="134,135,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364"/>
                <TextBox x:Name="numberLabel" HorizontalAlignment="Left" Margin="134,174,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364"/>
                <TextBox x:Name="usernameLabel" HorizontalAlignment="Left" Margin="134,213,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364"/>
                <TextBox x:Name="passwordLabel" HorizontalAlignment="Left" Margin="134,252,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="364"/>
                <Button Content="Изменить" HorizontalAlignment="Left" Margin="10,311,0,0" VerticalAlignment="Top" Height="37" Width="488" Click="Button_Click_3"/>
                <Button Content="Сохранить" HorizontalAlignment="Left" Margin="10,355,0,0" VerticalAlignment="Top" Height="37" Width="488" Click="Button_Click_5"/>
                <Button Content="Вернуться в меню" HorizontalAlignment="Left" Margin="10,397,0,0" VerticalAlignment="Top" Height="37" Width="488" Click="Button_Click"/>
            </Grid>
        </GroupBox>

    </Grid>
</Window>
