<Window x:Class="Konditer.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Konditer"
        mc:Ignorable="d"
        Title="Register" Height="482" Width="359">
    <Grid>
        <Button Content="Зарегистрироваться" HorizontalAlignment="Left" Margin="34,387,0,0" VerticalAlignment="Top" Height="29" Width="298" FontSize="16" Click="Button_Click"/>
        <Label Content="Введите логин" HorizontalAlignment="Left" Margin="34,64,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Регистрация" HorizontalAlignment="Left" Margin="111,15,0,0" VerticalAlignment="Top" FontSize="20"/>
        <Label Content="Введите пароль" HorizontalAlignment="Left" Margin="34,108,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Фамилия" HorizontalAlignment="Left" Margin="34,148,0,0" VerticalAlignment="Top" FontSize="16"/>
        <TextBox x:Name="usernameBox" HorizontalAlignment="Left" Margin="169,71,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="163" Height="24" FontSize="16"/>
        <TextBox x:Name="passwordBox" HorizontalAlignment="Left" Margin="169,112,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="163" Height="24" FontSize="16"/>
        <TextBox x:Name="firstBox" HorizontalAlignment="Left" Margin="169,152,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="163" Height="24" FontSize="16"/>
        <Label Content="Имя" HorizontalAlignment="Left" Margin="34,189,0,0" VerticalAlignment="Top" FontSize="16"/>
        <TextBox x:Name="nameBox" HorizontalAlignment="Left" Margin="169,193,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="163" Height="24" FontSize="16"/>
        <Label Content="Отчество" HorizontalAlignment="Left" Margin="34,231,0,0" VerticalAlignment="Top" FontSize="16"/>
        <TextBox x:Name="lastBox" HorizontalAlignment="Left" Margin="169,234,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="163" Height="24" FontSize="16"/>
        <Label Content="Почта" HorizontalAlignment="Left" Margin="34,272,0,0" VerticalAlignment="Top" FontSize="16"/>
        <TextBox x:Name="emailBox" HorizontalAlignment="Left" Margin="169,275,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="163" Height="24" FontSize="16"/>
        <Label Content="Номер&#xD;&#xA;Телефона" HorizontalAlignment="Left" Margin="34,311,0,0" VerticalAlignment="Top" FontSize="16" Width="95"/>
        <TextBox x:Name="numberBox" HorizontalAlignment="Left" Margin="169,325,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="163" Height="24" FontSize="16"/>

    </Grid>
</Window>
